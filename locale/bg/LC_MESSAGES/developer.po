msgstr "броят на записите, групирани в клетката"

#: ../../docs/content/developer/reference/user_interface/view_architectures.rst:3578
msgid "``readonly`` (optional)"
msgstr "``readonly`` (незадължителен)"

#: ../../docs/content/developer/reference/user_interface/view_architectures.rst:3578
msgid ""
"a boolean indicating that this specific cell should not be client-editable"
msgstr ""
"булева стойност, указваща, че тази конкретна клетка не трябва да бъде "
