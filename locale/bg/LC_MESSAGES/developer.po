msgstr ""
"версията на този модул, трябва да следва правилата на `semantic versioning`_"

#: ../../docs/content/developer/reference/backend/module.rst:46
msgid "``description`` (``str``)"
msgstr "``description`` (``str``)"

#: ../../docs/content/developer/reference/backend/module.rst:47
msgid "extended description for the module, in reStructuredText"
msgstr "разширено описание на модула, в reStructuredText"

#: ../../docs/content/developer/reference/backend/module.rst:48
