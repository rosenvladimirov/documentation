msgid "Canada"
msgstr "Канада"

#: ../../content/applications/sales/sales/amazon_connector/features.rst:88
msgid "Amazon.ca"
msgstr "Amazon.ca"

#: ../../content/applications/sales/sales/amazon_connector/features.rst:90
#: ../../content/applications/sales/sales/shopee_connector.rst:62
msgid "Mexico"
msgstr "Мексико"

