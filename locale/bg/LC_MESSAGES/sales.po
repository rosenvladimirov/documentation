msgstr ":guilabel:`amount_untaxed`: Сума без данък"

#: ../../content/applications/sales/sales/sales_quotations/pdf_quote_builder/dynamic_text.rst:194
msgid ":guilabel:`amount_total`: Total Amount"
msgstr ":guilabel:`amount_total`: Обща сума"

#: ../../content/applications/sales/sales/sales_quotations/pdf_quote_builder/dynamic_text.rst:195
msgid ":guilabel:`delivery_date`: Delivery Date"
