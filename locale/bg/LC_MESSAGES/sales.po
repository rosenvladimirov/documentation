msgstr ":guilabel:`uom`: Мерна единица (UoM)"

#: ../../content/applications/sales/sales/sales_quotations/pdf_quote_builder/dynamic_text.rst:205
msgid ":guilabel:`price_unit`: Price Unit"
msgstr ":guilabel:`price_unit`: Единична цена"

#: ../../content/applications/sales/sales/sales_quotations/pdf_quote_builder/dynamic_text.rst:206
msgid ":guilabel:`discount`: Discount"
msgstr ":guilabel:`discount`: Отстъпка"

#: ../../content/applications/sales/sales/sales_quotations/pdf_quote_builder/dynamic_text.rst:207
