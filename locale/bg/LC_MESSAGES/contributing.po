msgstr "Частни атрибути (``_name``, ``_description``, ``_inherit``, ...)"

#: ../../docs/content/contributing/development/coding_guidelines.rst:914
msgid "Default method and ``default_get``"
msgstr "Default метод и ``default_get``"

#: ../../docs/content/contributing/development/coding_guidelines.rst:915
msgid "Field declarations"
msgstr "Декларации на полета"

#: ../../docs/content/contributing/development/coding_guidelines.rst:916
msgid "SQL constraints and indexes"
msgstr "SQL ограничения (constraints) и индекси"

#: ../../docs/content/contributing/development/coding_guidelines.rst:917
msgid ""
"Compute, inverse and search methods in the same order as field declaration"
msgstr ""
"Compute, inverse и search методи в същия ред, както декларацията на полетата"

#: ../../docs/content/contributing/development/coding_guidelines.rst:918
msgid ""
"Selection method (methods used to return computed values for selection "
"fields)"
msgstr ""
"Selection методи (методи, използвани за връщане на изчислени стойности за "
